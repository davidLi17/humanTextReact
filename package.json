{
  "name": "human-text-translator",
  "description": "人话翻译器 - 将专业术语翻译成通俗易懂的\"人话\"",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
