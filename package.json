{
  "name": "human-language-translator",
  "description": "A browser extension that translates text from 行业黑话 to 让人易于理解的话",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "bun run test:fast && bun run test:components",
    "test:fast": "bun test tests/unit tests/contracts tests/integration tests/helpers",
    "test:unit": "bun test tests/unit",
    "test:contract": "bun test tests/contracts",
    "test:integration": "bun test tests/integration",
    "test:shared": "bun test tests/unit tests/contracts tests/integration tests/helpers --parallel=1 --no-isolate --randomize --seed ${TEST_SEED:-$RANDOM}",
    "test:components": "bun test --preload=./tests/components/preload.ts --parallel=1 --no-isolate --randomize --seed ${TEST_SEED:-$RANDOM} ./tests/components/*.component.tsx",
    "test:coverage": "bun test tests/unit tests/contracts tests/integration tests/helpers --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:e2e": "bun run build && bunx playwright test",
    "test:e2e:built": "bunx playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@icon-park/react": "^1.4.2",
    "ahooks": "^3.9.6",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "fuse.js": "^7.1.0",
    "less": "^4.4.1",
    "lodash-es": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wxt": "^0.20.6"
  },
  "overrides": {
    "@vitejs/plugin-react": "^5.1.4"
  }
}
