    "ahooks": "^3.9.6",
    "dayjs": "^1.11.13",
    "debug": "^4.4.1",
    "fuse.js": "^7.1.0",
    "less": "^4.4.1",
    "lodash-es": "^4.17.21",
    "piscina": "^5.1.3",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wxt": "^0.20.6"
  }
